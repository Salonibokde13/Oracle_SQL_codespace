import sqlite3


# Connect to SQLite and create the company.db database if it does not exist.
connection = sqlite3.connect("company.db")

# Create a cursor for executing SQL statements.
cursor = connection.cursor()

# Create the department and employee tables.
cursor.execute("""
	CREATE TABLE IF NOT EXISTS department (
		id INTEGER PRIMARY KEY,
		name TEXT,
		location TEXT
	)
""")

cursor.execute("""
	CREATE TABLE IF NOT EXISTS employee (
		id INTEGER PRIMARY KEY,
		name TEXT,
		deptid INTEGER
	)
""")

# Insert exactly five departments. The IT department has no employees.
departments = [
	(1, "Human Resources", "Mumbai"),
	(2, "Finance", "Delhi"),
	(3, "Information Technology", "Bengaluru"),
	(4, "Sales", "Chennai"),
	(5, "Operations", "Hyderabad")
]

# Insert exactly five employees. Employee 5 has no matching department.
employees = [
	(1, "Aarav Sharma", 1),
	(2, "Priya Patel", 2),
	(3, "Rohan Mehta", 4),
	(4, "Ananya Singh", 5),
	(5, "Vikram Rao", 99)
]

# Execute SQL statements to insert the records.
cursor.executemany(
	"INSERT INTO department (id, name, location) VALUES (?, ?, ?)",
	departments
)

cursor.executemany(
	"INSERT INTO employee (id, name, deptid) VALUES (?, ?, ?)",
	employees
)

# Save the inserted records in the database.
connection.commit()

# Fetch and display all employee records.
print("Employees:")
print("ID | Name         | DeptID")
print("--------------------------")
cursor.execute("SELECT id, name, deptid FROM employee")
employee_rows = cursor.fetchall()

for employee in employee_rows:
	print(f"{employee[0]} | {employee[1]:12} | {employee[2]}")

print()

# Fetch and display all department records.
print("Departments:")
print("ID | Name                   | Location")
print("---------------------------------------")
cursor.execute("SELECT id, name, location FROM department")
department_rows = cursor.fetchall()

for department in department_rows:
	print(f"{department[0]} | {department[1]:22} | {department[2]}")

# Find employees who work in the Human Resources department.
print()
print("Employees in the HR Department:")
cursor.execute("""
	SELECT employee.name
	FROM employee
	INNER JOIN department ON employee.deptid = department.id
	WHERE department.name = 'Human Resources'
""")
hr_employee_rows = cursor.fetchall()

for employee in hr_employee_rows:
	print(employee[0])

# Close the cursor and database connection properly.
cursor.close()
connection.close()
